# ==============================================================================
# TEMPLATE ENVIRONMENT VARIABLES UNTUK VERCEL DEPLOYMENT (DENGAN AIVEN MYSQL)
# Masukkan variable berikut ke: Vercel Dashboard -> Project Settings -> Environment Variables
# ==============================================================================

# Laravel App Configuration
APP_NAME="Pesan Ticket"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://nama-project-anda.vercel.app
APP_KEY=base64:GENERATE_KEY_DARI_PHP_ARTISAN_KEY_GENERATE_SHOW

# Storage & Temporary Paths (Wajib untuk Vercel Serverless)
LOG_CHANNEL=stderr
VIEW_COMPILED_PATH=/tmp/storage/framework/views
APP_CONFIG_CACHE=/tmp/config.php
APP_EVENTS_CACHE=/tmp/events.php
APP_PACKAGES_CACHE=/tmp/packages.php
APP_ROUTES_CACHE=/tmp/routes.php
APP_SERVICES_CACHE=/tmp/services.php

# Session, Cache & Queue Driver
SESSION_DRIVER=cookie
CACHE_STORE=array
QUEUE_CONNECTION=sync

# ==============================================================================
# KONFIGURASI AIVEN MYSQL
# Ambil detail ini dari Aiven Console (Overview -> Connection Information)
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=mysql-xxxx-xxxx.aivencloud.com
DB_PORT=19999
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=password_dari_aiven_anda

# SSL Setting untuk Aiven di Vercel:
# Set ke false jika tidak upload file ca.pem manual agar koneksi SSL tetap terenkripsi tanpa gagal verifikasi sertifikat lokal
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=false
